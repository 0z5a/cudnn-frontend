ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.2/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=a3_guarded_rounding_20261002_r9_route_decode -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/jwipc/experiments/cudnn-sm110-a1-a3-20260928/venvs/a3sfdlatestac89/lib/python3.12/site-packages/torch/include -isystem /home/jwipc/experiments/cudnn-sm110-a1-a3-20260928/venvs/a3sfdlatestac89/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.2/include -isystem /usr/include/python3.12 -fPIC -std=c++20 -O2
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=a3_guarded_rounding_20261002_r9_route_decode -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/jwipc/experiments/cudnn-sm110-a1-a3-20260928/venvs/a3sfdlatestac89/lib/python3.12/site-packages/torch/include -isystem /home/jwipc/experiments/cudnn-sm110-a1-a3-20260928/venvs/a3sfdlatestac89/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.2/include -isystem /usr/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_110,code=sm_110 --compiler-options '-fPIC' -O2 --ftz=false --fmad=false -std=c++20
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/jwipc/experiments/cudnn-sm110-a1-a3-20260928/venvs/a3sfdlatestac89/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda-13.2/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build a3_guarded_rounding_native_20261002_r9_route_decode.o: compile /home/jwipc/experiments/cudnn-sm110-a1-a3-20260928/tools/a3_guarded_rounding_native_20261002_r9_route_decode.cpp
